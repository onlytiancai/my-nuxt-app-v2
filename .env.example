# 文件上传配置示例
# 复制此文件为 .env 并根据需要修改配置

# ===========================================
# 本地上传配置
# ===========================================

# 上传目录（相对路径或绝对路径）
# 相对路径：相对于项目根目录
# 绝对路径：以 / 开头（Linux/Mac）或盘符开头（Windows）
NUXT_UPLOAD_DIR=public/uploads

# 上传文件的访问 URL 基础路径
NUXT_UPLOAD_BASE_URL=/uploads

# 如果需要存储到非项目目录，可以使用绝对路径：
# Linux/Mac: NUXT_UPLOAD_DIR=/var/www/uploads
# Windows: NUXT_UPLOAD_DIR=D:/uploads

# ===========================================
# S3/MinIO 上传配置
# ===========================================

# MinIO 本地开发配置示例
NUXT_S3_ENDPOINT=http://localhost:9000
NUXT_S3_ACCESS_KEY=minioadmin
NUXT_S3_SECRET_KEY=minioadmin
NUXT_S3_BUCKET=uploads
NUXT_S3_REGION=us-east-1

# AWS S3 生产配置示例
# NUXT_S3_ENDPOINT=https://s3.amazonaws.com
# NUXT_S3_ACCESS_KEY=your-aws-access-key
# NUXT_S3_SECRET_KEY=your-aws-secret-key
# NUXT_S3_BUCKET=your-bucket-name
# NUXT_S3_REGION=us-east-1

# 阿里云 OSS 配置示例 (使用 S3 兼容模式)
# NUXT_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# NUXT_S3_ACCESS_KEY=your-aliyun-access-key
# NUXT_S3_SECRET_KEY=your-aliyun-secret-key
# NUXT_S3_BUCKET=your-bucket-name
# NUXT_S3_REGION=cn-hangzhou

# 腾讯云 COS 配置示例 (使用 S3 兼容模式)
# NUXT_S3_ENDPOINT=https://cos.ap-beijing.myqcloud.com
# NUXT_S3_ACCESS_KEY=your-tencent-access-key
# NUXT_S3_SECRET_KEY=your-tencent-secret-key
# NUXT_S3_BUCKET=your-bucket-name
# NUXT_S3_REGION=ap-beijing
